{
  "name": "@enapragma/lifeos",
  "version": "0.1.0",
  "description": "Opinionated installer CLI for LifeOS internal beta",
  "bin": {
    "lifeos": "bin/lifeos.js"
  },
  "files": [
    "bin/",
    "README.md"
  ],
  "scripts": {
    "check": "node --check bin/lifeos.js",
    "smoke": "node bin/lifeos.js --help && node bin/lifeos.js path"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ena-pragma/lifeos-installer.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "UNLICENSED",
  "private": false
}
